{
  "$schema": "https://opencode.ai/schemas/config.json",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub PRs, issues, repo management"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "Local file operations"
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "vercel-mcp"],
      "description": "Vercel deployments, preview URLs, logs"
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      },
      "description": "Database management, RLS policies"
    },
"google-cloud": {
      "command": "npx",
      "args": ["-y", "@google/mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      },
      "description": "GCP Document AI, Cloud Run"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "context7-mcp"],
      "description": "Real-time library docs, reduces context bloat"
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Web search for validation"
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "URL content fetching"
    }
  },
  "instructions": "./AGENTS.md",
  "context": {
    "maxTokens": 120000,
    "truncateAfter": 80000,
    "ragThreshold": 0.7
  }
}