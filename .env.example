# ============================================================================
# Creditax.ai — Environment Reference (all build phases P3→P6 + Track B)
# ----------------------------------------------------------------------------
# HOW TO USE:
#   1. cp .env.example .env   (.env is gitignored — real keys live ONLY there)
#   2. Fill what you need. Track A (demo) degrades gracefully: with ZERO keys
#      the app still runs offline on inlined demo seed + local-hash
#      embeddings, and every mocked output is tagged demo_seed=true.
#   3. Add keys as you get them — nothing blocks the demo on a missing key.
#
# TAGS:
#   [CORE]   demo requires (or strongly upgrades) it
#   [OPT]    demo benefits; safe to skip, fallback exists
#   [TRACK-B] production wiring only; demo uses the shaped interface + mocks
# ============================================================================

# ---------------------------------------------------------------------------
# RUNTIME / APP
# ---------------------------------------------------------------------------
# demo | development | production — drives demo_seed banner behaviour
CREDITAX_ENV=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# POCKETBASE  [CORE]  (Track A data spine — F-01, F-02, P5 boards)
# Already have local version on my vps see $oracle-vps skill
# run `./pocketbase` → serves http://127.0.0.1:8090 (admin on /_/).
# Flag OFF (unset/false): app uses inlined demo seed and skips PB entirely.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_POCKETBASE=false
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Server-side only (never NEXT_PUBLIC_): superuser API creds used for
# seeding migrations/collections from scripts (not the auth flow).
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
# P16: optional client-side fallback base, used when both NEXT_PUBLIC_* and
# POCKETBASE_URL are unset (pb-features / pocketbase / pb-auth URL chain).
NEXT_PUBLIC_POCKETBASE_FALLBACK_URL=

# ---------------------------------------------------------------------------
# LLM — LITELLM.dev (primary, OpenAI-compatible)  [CORE for cited answers]
# It has 41 models from over 5 providers choose the most stables and route to different models as needed i.e chat, rag, scoring etc
# ---------------------------------------------------------------------------
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm.LITELLM.dev/openai/v1
# P13: model must exist on the LITELLM host. The host's live catalog is 41
# models (see GET /v1/models); minimax-m2.7 is NOT currently listed there, so
# the default below is a model id that is. At runtime the resolver is
# LITELLM_MODEL -> KIMCHI_MODEL -> first available; re-check the catalog before
# pinning a model (call /v1/models).
LITELLM_MODEL=agnes/agnes-3.0-flash

# ---------------------------------------------------------------------------
# LLM — KIMCHI.dev (legacy second leg, P13). Committed code reads KIMCHI_* as
# the second fallback after LITELLM (llmEndpoints in src/ai/rag/llm.ts). The
# live .env's KIMCHI_MODEL is a model id the LITELLM host actually serves, so
# it doubles as the resolved model when LITELLM_MODEL is empty.
# ---------------------------------------------------------------------------
KIMCHI_API_KEY=
KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
KIMCHI_MODEL=agnes/agnes-3.0-flash

# ---------------------------------------------------------------------------
# EMBEDDINGS — cascade: OpenRouter → Hugging Face → Vertex → local-hash
# (local-hash needs NO key; demo ranking works offline, tagged demo_seed)
# ---------------------------------------------------------------------------
# OpenRouter [CORE for "real" RAG quality] — openrouter.ai/keys
# Model nvidia/nemotron-3-embed-1b:free is free; no credit card needed.
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free

# Hugging Face [OPT] — huggingface.co/settings/tokens
# Model all-MiniLM-L6-v2 (384-dim) via Inference API free tier.
HF_API_KEY=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Google Vertex AI [OPT] — GCP project + service account JSON:
#   gsutil cp service-account.json ./secrets/vertex-sa.json (keep out of git)
VERTEX_AI_PROJECT_ID=
VERTEX_AI_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_PATH=./secrets/vertex-sa.json

# ---------------------------------------------------------------------------
# MAPBOX — geocoding + map tiles (marketplace "near me", F-14)  [OPT]
# account.mapbox.com → Tokens → create a public token (Geocoding +
# Maps APIs enabled). 100k free requests/month, no card for dev.
# NEXT_PUBLIC_ is read by the browser-side map; plain is server-side.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.
MAPBOX_ACCESS_TOKEN=pk.

# ---------------------------------------------------------------------------
# CREDIT / IDENTITY — Mono (primary) + Jumo (partnership)  [TRACK-B]
# Demo runs on the shaped provider interface with deterministic mocks;
# fill these when flipping credit-scoring.mono-integration to live.
# Get keys: monodash.com → Dashboard → Developers. Use SANDBOX env.
MONO_API_KEY=
MONO_BASE_URL=https://sandbox.api.mono.co
MONO_ENVIRONMENT=sandbox
JUMO_API_KEY=
JUMO_BASE_URL=https://api.jumo.world/v2

# ---------------------------------------------------------------------------
# FILE STORAGE — Backblaze B2 (documents) + Cloudinary (images)  [OPT]
# B2: backblaze.com console → Key Pairs → New Key Pair. 10 GB free.
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_BUCKET=creditax-demo
BACKBLAZE_B2_REGION=eu-west-1
BACKBLAZE_B2_ENDPOINT=https://s3.eu-west-1.backblazeb2.com
# Cloudinary: dashboard.cloudinary.com (free 25 credits/mo). Either split
# vars or a single CLOUDINARY_URL=cloudinary://key:secret@cloudname
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ---------------------------------------------------------------------------
# BILLING — Paystack (primary, NGN) + Flutterwave (alt)  [TRACK-B]
# Demo tier-upgrade flips a PocketBase record + toast; real PSP wiring is
# Track B. dashboard.paystack.com → Settings → API keys (Test keys first).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENVIRONMENT=test

# ---------------------------------------------------------------------------
# BACKGROUND JOBS — Trigger.dev  [TRACK-B]
# trigger.dev dashboard → project settings → credentials.
TRIGGER_PROJECT_KEY=
TRIGGER_DEPLOYMENT_ID=
TRIGGER_SECRET=

# ---------------------------------------------------------------------------
# NOTIFICATIONS — email + SMS  [OPT]
# Filing-deadline alerts (F-08) demo with in-app bell; real push via:
RESEND_API_KEY=            # resend.com (email)
TWILIO_ACCOUNT_SID=        # twilio.com (SMS)
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# AUTH / SESSIONS
# ---------------------------------------------------------------------------
# Reserved — not yet consumed by any code path (P16 key-sweep: documented,
# not silently "wired"). A real signed-cookie session store is a Track B
# upgrade; the P7/P12 unified auth spine (src/lib/auth.ts → pb-auth + mock)
# does not read this secret. Set it when a cookie/JWT signer is introduced
# so the value is already in place.
AUTH_SESSION_SECRET=
# Demo API key surfaced on the developer quickstart page (public, not secret).
# P16: consumed by the developer portal (src/app/[locale]/developers/*) as the
# seeded public demo key.
CREDITAX_API_KEY=sk_demo_creditax_v1_00000000

# ---------------------------------------------------------------------------
# RATE LIMITING (core-api deferred item — Track B)
# Per pricing-and-access.md: API access 100 sandbox calls/mo (free tier).
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# LEGACY (Supabase — original plan; PocketBase is the current Track A spine).
# Keep only if a migration to Supabase pgvector (Track B) lands.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
